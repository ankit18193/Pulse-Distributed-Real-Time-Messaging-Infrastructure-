# ==============================================================================
# Pulse — Real-Time Messaging Infrastructure Environment Configuration
# Template: Copy to .env and adjust values for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Bindings
# ------------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Node Identity & Distributed Routing
# MUST be globally unique per running node in a cluster to avoid self-echo drop.
# ------------------------------------------------------------------------------
INSTANCE_ID=pulse-node-1

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# In production, MUST be set to a cryptographically secure string (min 32 chars).
# ------------------------------------------------------------------------------
AUTH_SECRET=pulse-dev-secret-key-32chars-min

# ------------------------------------------------------------------------------
# 4. WebSocket Transport & Backpressure Limits
# ------------------------------------------------------------------------------
# Inbound frame size ceiling (bytes). Default: 64 KiB
MAX_PAYLOAD_BYTES=65536

# Outbound buffer threshold before slow consumer termination (bytes). Default: 1 MiB
MAX_BUFFERED_AMOUNT_BYTES=1048576

# Transport heartbeat ping frequency and reap timeout (milliseconds)
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 5. Reliability & Idempotency
# ------------------------------------------------------------------------------
# Maximum in-memory LRU deduplication entries
IDEMPOTENCY_CAPACITY=10000

# Deduplication time window before entries expire (milliseconds)
IDEMPOTENCY_TTL_MS=60000

# ------------------------------------------------------------------------------
# 6. Distributed Scale-Out & Redis Pub/Sub (Phase 3)
# ------------------------------------------------------------------------------
# Enable Redis distributed messaging (set to true for multi-node deployments)
REDIS_ENABLED=false

# Full Redis connection URI (takes precedence over REDIS_HOST/PORT when provided)
# REDIS_URL=redis://127.0.0.1:6379

# Discrete connection parameters (used if REDIS_URL is omitted)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# Reconnection retry policy (exponential backoff)
REDIS_RETRY_MAX_ATTEMPTS=10
REDIS_RETRY_INITIAL_DELAY_MS=100
REDIS_RETRY_MAX_DELAY_MS=3000

# ------------------------------------------------------------------------------
# 7. Distributed Presence Engine (Phase 4)
# ------------------------------------------------------------------------------
# Lease TTL before inactive/crashed connections expire (milliseconds). Default: 60s
PRESENCE_TTL_MS=60000

# Background renewal flush frequency to pipeline active leases into Redis. Default: 15s
PRESENCE_FLUSH_INTERVAL_MS=15000
