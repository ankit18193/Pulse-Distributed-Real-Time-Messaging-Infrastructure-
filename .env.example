# Pulse Single-Node Realtime Engine Configuration (Phase 1)
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
INSTANCE_ID=pulse-node-1

# Heartbeat & Liveness (Milliseconds)
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=10000

# Security & Constraints
MAX_PAYLOAD_BYTES=65536
AUTH_SECRET=pulse-dev-secret-key-32chars-min

# Distributed Scale-Out & Redis Pub/Sub (Phase 3)
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_RETRY_MAX_ATTEMPTS=10
REDIS_RETRY_INITIAL_DELAY_MS=100
REDIS_RETRY_MAX_DELAY_MS=3000
