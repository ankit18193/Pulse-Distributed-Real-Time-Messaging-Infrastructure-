# Pulse Single-Node Realtime Engine Configuration (Phase 1)
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
INSTANCE_ID=pulse-node-1

# Heartbeat & Liveness (Milliseconds)
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=10000

# Security & Constraints
MAX_PAYLOAD_BYTES=65536
AUTH_SECRET=pulse-dev-secret-key-32chars-min
